# Sourced by the generated lefthook git hooks (see `rc:` in lefthook.yml).
# Git runs hooks with a minimal PATH that lacks node_modules/.bin, so the preset's
# bare oxfmt/oxlint commands resolve only after this prepends the repo bin dir.
# Git always invokes hooks with cwd = repo root, so a plain relative path is enough —
# and it must stay relative: on this Windows/git-bash setup `git rev-parse
# --show-toplevel` returns a drive-letter path (e.g. `F:/...`), and that colon after
# the drive letter corrupts the `:`-separated PATH list (splits into "F" and the rest),
# silently dropping node_modules/.bin and making every oxfmt/oxlint hook step fail with
# "command not found" (exit 127) on every commit — verified 2026-08-18.
PATH="./node_modules/.bin:$PATH"
export PATH
